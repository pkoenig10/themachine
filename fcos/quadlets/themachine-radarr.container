[Unit]
Description=Themachine radarr container
Requires=var-lib-themachine-data.mount
After=var-lib-themachine-data.mount

[Container]
Image=docker.io/linuxserver/radarr
ContainerName=radarr
Pull=always
SecurityLabelDisable=true
Network=containers.network
User=1000:100
Volume=/var/lib/themachine/config/radarr/config:/config
Volume=/var/lib/themachine/data:/data

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
