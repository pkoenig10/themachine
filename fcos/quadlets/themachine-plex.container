[Unit]
Description=Themachine plex container
Requires=var-lib-themachine-data.mount
After=var-lib-themachine-data.mount

[Container]
Image=docker.io/linuxserver/plex
ContainerName=plex
Pull=always
SecurityLabelDisable=true
Network=containers.network
User=1000:100
AddDevice=/dev/dri
Tmpfs=/transcode
PublishPort=32400:32400
Volume=/var/lib/themachine/config/plex/config:/config
Volume=/var/lib/themachine/data:/data

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
