# Generated by ../generate-butane.py; transpile with --files-dir repository-root.
variant: "fcos"
version: "1.7.0"
passwd:
  users:
    - name: "core"
      ssh_authorized_keys:
        - "ssh-rsa "
storage:
  directories:
    - path: "/var/lib/themachine"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/data"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/etc/themachine"
      mode: 493
      user:
        id: 0
      group:
        id: 0
    - path: "/var/lib/themachine/config/caddy"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/caddy/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/plex"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/plex/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/prowlarr"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/prowlarr/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/radarr"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/radarr/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/seerr"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/seerr/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/sonarr"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/sonarr/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/tautulli"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/tautulli/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/transmission"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/transmission/config"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
    - path: "/var/lib/themachine/config/caddy/data"
      mode: 493
      user:
        id: 1000
      group:
        id: 100
  files:
    - path: "/etc/hostname"
      mode: 420
      overwrite: true
      contents:
        inline: |
          themachine
    - path: "/etc/ssh/sshd_config.d/20-themachine.conf"
      mode: 420
      contents:
        inline: |
          Port 5492
          PasswordAuthentication no
          PermitRootLogin no
    - path: "/etc/themachine/caddy/Caddyfile"
      mode: 420
      contents:
        local: "caddy/Caddyfile"
    - path: "/etc/themachine/backup/config.yml"
      mode: 420
      contents:
        inline: |
          files:
            - config/plex/config/Library/Application Support/Plex Media Server/Preferences.xml
            - config/seerr/config/settings.json
            - config/prowlarr/config/Backups/**
            - config/radarr/config/Backups/**
            - config/sonarr/config/Backups/**
            - config/tautulli/config/backups/**
            - config/transmission/config/transmission-home/settings.json
            - etc/themachine/**/.env
            - etc/themachine/auth/config.yml
            - etc/themachine/backup/credentials.json
    - path: "/etc/themachine/telegraf/telegraf.conf"
      mode: 420
      contents:
        local: "fcos/telegraf.conf"
  trees:
    - local: "fcos/quadlets"
      path: "/etc/containers/systemd"
systemd:
  units:
    - name: "zpool-import-pool.service"
      contents: |
        [Unit]
        Description=Import existing ZFS pool
        Before=var-lib-themachine-data.mount
        
        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/bin/sh -c 'zpool list -H pool >/dev/null 2>&1 || zpool import -N pool'
    - name: "var-lib-themachine-data.mount"
      enabled: true
      contents: |
        [Unit]
        Description=Mount existing pool/data dataset
        Requires=zpool-import-pool.service
        After=zpool-import-pool.service
        
        [Mount]
        What=pool/data
        Where=/var/lib/themachine/data
        Type=zfs
        
        [Install]
        WantedBy=multi-user.target
    - name: "themachine-backup.timer"
      enabled: true
      contents: |
        [Unit]
        Description=Run themachine backup daily
        
        [Timer]
        OnCalendar=*-*-* 04:00:00
        Persistent=true
        Unit=themachine-backup.service
        
        [Install]
        WantedBy=timers.target
    - name: "themachine-prune.service"
      contents: |
        [Unit]
        Description=Prune unused Podman images and volumes
        
        [Service]
        Type=oneshot
        ExecStart=/usr/bin/podman system prune --all --volumes --force
    - name: "themachine-prune.timer"
      enabled: true
      contents: |
        [Unit]
        Description=Prune containers weekly
        
        [Timer]
        OnCalendar=Sun *-*-* 03:00:00
        Persistent=true
        Unit=themachine-prune.service
        
        [Install]
        WantedBy=timers.target
    - name: "podman.socket"
      enabled: true
    - name: "sshd.service"
      dropins:
        - name: "10-themachine-selinux-port.conf"
          contents: |
            [Service]
            ExecStartPre=/bin/sh -c '/usr/sbin/semanage port -a -t ssh_port_t -p tcp 5492 || /usr/sbin/semanage port -m -t ssh_port_t -p tcp 5492'
